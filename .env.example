# EvidRover-Lite Environment Variables
# Rename this file to .env or set these in your terminal / PowerShell

# 1. Choose provider: 'gemini', 'openai_compatible', 'anthropic', or 'mock'
LLM_PROVIDER=gemini

# 2. Add your Gemini API key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# 3. Model selection (default is gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# 4. Optional GitHub Token for retrieving issues & PRs without rate limiting
# GITHUB_TOKEN=your_github_token_here
